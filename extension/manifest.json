{
  "manifest_version": 3,
  "name": "Perf Intelligence DevTools",
  "version": "0.3.0",
  "description": "DevTools panel for the frontend performance intelligence engine: causal traces, insights, budgets.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools/devtools.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
