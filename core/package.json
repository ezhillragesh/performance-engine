{
  "name": "frontend-performance-intelligence-engine",
  "version": "0.3.0",
  "description": "Runtime analysis engine for frontend performance intelligence.",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:core && npm run test:a11y",
    "test:core": "vitest run",
    "test:a11y": "vitest run -c vitest.a11y.config.ts",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "build:extension": "node scripts/build-extension.mjs",
    "build:a11y": "node scripts/build-a11y.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "accessibility-checker-engine": "4.0.34",
    "axe-core": "4.13.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
