{
  "name": "performance-engine",
  "version": "0.4.0",
  "description": "In-browser frontend performance intelligence: causal interaction traces, React render instrumentation, evidence-based insights, Core Web Vitals, budgets and an accessibility audit. Zero dependencies.",
  "keywords": [
    "performance",
    "web-performance",
    "react",
    "react-performance",
    "render",
    "profiling",
    "core-web-vitals",
    "web-vitals",
    "inp",
    "lcp",
    "cls",
    "long-tasks",
    "long-animation-frames",
    "tracing",
    "devtools",
    "rum",
    "observability",
    "accessibility",
    "a11y",
    "wcag"
  ],
  "homepage": "https://github.com/ezhillragesh/performance-engine/tree/main/core#readme",
  "bugs": {
    "url": "https://github.com/ezhillragesh/performance-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezhillragesh/performance-engine.git",
    "directory": "core"
  },
  "license": "MIT",
  "author": "Ezhill Ragesh",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('../THIRD_PARTY_NOTICES.md','dist/THIRD_PARTY_NOTICES.md')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:core && npm run test:a11y",
    "test:core": "vitest run",
    "test:a11y": "vitest run -c vitest.a11y.config.ts",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "build:extension": "node scripts/build-extension.mjs",
    "build:a11y": "node scripts/build-a11y.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:package"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "accessibility-checker-engine": "4.0.34",
    "axe-core": "4.13.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
